{
  "name": "helpkey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "media:backfill": "tsx --env-file=.env.local scripts/media-backfill.ts",
    "media:migrate-legacy-private": "tsx --env-file=.env.local scripts/migrate-legacy-private-media.ts",
    "media:repair-bookings": "tsx --env-file=.env.local scripts/repair-booking-media.ts",
    "build:workers": "esbuild workers/media/runner.ts workers/media/dispatcher.ts workers/media/cleanup.ts workers/media/migrate-firestore-jobs.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist/workers/media --external:sharp",
    "worker:media": "node --env-file=.env.local dist/workers/media/runner.js",
    "worker:dispatcher": "node --env-file=.env.local dist/workers/media/dispatcher.js",
    "worker:cleanup": "node --env-file=.env.local dist/workers/media/cleanup.js",
    "worker:migrate-firestore-jobs": "node --env-file=.env.local dist/workers/media/migrate-firestore-jobs.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "bullmq": "^6.3.4",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.40.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
