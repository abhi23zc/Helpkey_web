{
  "name": "helpkey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env.local scripts/dev-services.ts",
    "all": "npm run build:workers && tsx --env-file=.env.local scripts/dev-services.ts --all",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:hotel": "playwright test --config playwright.hotel.config.ts",
    "load:test": "tsx scripts/load-test.ts",
    "projection:backfill": "tsx --env-file=.env.local scripts/projection-backfill.ts",
    "media:backfill": "tsx --env-file=.env.local scripts/media-backfill.ts",
    "media:migrate-legacy-private": "tsx --env-file=.env.local scripts/migrate-legacy-private-media.ts",
    "media:repair-bookings": "tsx --env-file=.env.local scripts/repair-booking-media.ts",
    "reviews:publish-pending": "tsx --env-file=.env.local scripts/publish-pending-reviews.ts",
    "build:workers": "esbuild workers/media/runner.ts workers/media/dispatcher.ts workers/media/cleanup.ts workers/media/migrate-firestore-jobs.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist/workers/media --external:sharp && esbuild workers/projections/runner.ts workers/projections/dispatcher.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist/workers/projections --external:sharp && esbuild workers/bookings/runner.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist/workers/bookings && esbuild workers/shared/recovery-runner.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist/workers/shared --external:sharp",
    "worker:media": "node --env-file=.env.local dist/workers/media/runner.js",
    "worker:dispatcher": "node --env-file=.env.local dist/workers/media/dispatcher.js",
    "worker:cleanup": "node --env-file=.env.local dist/workers/media/cleanup.js",
    "worker:migrate-firestore-jobs": "node --env-file=.env.local dist/workers/media/migrate-firestore-jobs.js",
    "worker:projection": "node --env-file=.env.local dist/workers/projections/runner.js",
    "worker:projection-dispatcher": "node --env-file=.env.local dist/workers/projections/dispatcher.js",
    "worker:bookings": "node --env-file=.env.local dist/workers/bookings/runner.js",
    "bookings:indexes": "tsx --env-file=.env.local scripts/booking-indexes.ts",
    "bookings:cutover": "tsx --env-file=.env.local scripts/booking-inventory-cutover.ts",
    "bookings:archive-old-hourly": "tsx --env-file=.env.local scripts/archive-legacy-hourly-rates.ts",
    "bookings:reconcile": "tsx --env-file=.env.local scripts/booking-inventory-reconcile.ts",
    "test:bookings:emulator": "vitest run tests/booking-transactions.emulator.test.ts",
    "background:migrate": "tsx --env-file=.env.local scripts/background-migrate.ts",
    "reviews:rebuild": "tsx --env-file=.env.local scripts/reviews-rebuild.ts",
    "test:workers:integration": "vitest run tests/background.integration.test.ts tests/booking-transactions.emulator.test.ts tests/queue-delivery.integration.test.ts",
    "worker:recovery": "node --env-file=.env.local dist/workers/shared/recovery-runner.js",
    "background:rebuild": "tsx --env-file=.env.local scripts/background-rebuild.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@tanstack/react-query": "^5.103.2",
    "@types/qrcode.react": "^1.0.5",
    "bullmq": "^6.3.4",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.40.0",
    "next": "16.3.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/autocannon": "^7.12.7",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
