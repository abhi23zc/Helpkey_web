v>;\n}\n\nfunction internalRateCode(rateName: string) {\n  const code = rateName.toUpperCase().replace(/[^A-Z0-9]+/g, \"_\").replace(/^_+|_+$/g, \"\").slice(0, 28);\n  return code.length >= 2 ? `${code}_HK` : \"STANDARD_HK\";\n}"
